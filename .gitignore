backend/target/
backend/application-local.yml
backend/.env

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Virtual environment folders
venv/
.venv/
env/

